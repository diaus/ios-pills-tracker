{
  "mcpServers": {
    "graft": {
      "command": "graft",
      "args": [
        "mcp"
      ]
    },
    "MobileBuildMCP": {
      "command": "npx",
      "args": [
        "-y",
        "mobilebuildmcp@latest",
        "mcp"
      ],
      "env": {
        "MOBILEBUILDMCP_SENTRY_DISABLED": "true"
      }
    }
  }
}
